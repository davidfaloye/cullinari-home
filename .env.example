# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000
# Public URL of the site. Used in emails and as the Paystack callback base.
APP_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/cullinari
# Long random string. Signs login sessions.
JWT_SECRET=change-me-to-a-long-random-string
# 64 hex characters (32 bytes). Encrypts the admin login details shown to clients.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Paystack (https://dashboard.paystack.com/#/settings/developers)
PAYSTACK_SECRET_KEY=sk_test_xxx
# Optional. Paystack plan codes for the monthly subscription that starts one month after the first payment.
# Create one monthly plan per tier in the Paystack dashboard (₦28,000 / ₦63,000 / ₦140,000).
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_PRO=

# Email over SMTP. Leave SMTP_HOST empty in development: emails are printed to the console instead.
# Gmail: turn on 2-Step Verification, create an app password at https://myaccount.google.com/apppasswords,
# then use the values below. MAIL_FROM must be the Gmail address itself (or a "Send mail as" alias
# you have added in Gmail settings), otherwise Gmail replaces it with the Gmail address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cullinari <hello@cullinari.com>"
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=abcd efgh ijkl mnop
#   MAIL_FROM="Cullinari <yourname@gmail.com>"
# Optional: where customer replies go, e.g. hello@cullinari.com.
MAIL_REPLY_TO=
# Where new-application and payment alerts for the Cullinari team go.
TEAM_EMAIL=team@cullinari.com

# Where uploaded logos, splash art and menus are stored. On Render, point this at a persistent disk.
UPLOAD_DIR=./uploads
